{% from "em-map/macro.njk" import emMap %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Map</title>
    <link rel="icon" href="/assets/images/favicon.ico" />
    <link rel="stylesheet" href="/assets/map/map.css" />
    <script type="module" src="/assets/map/map.js"></script>
  </head>
  <body>
    {{
      emMap({
        cspNonce: cspNonce,
        controls: {
          zoomControl: false,
          rotateControl: controls.compass,
          scaleControl: controls.scaleBar,
          grabCursor: false
        }
      })
    }}
  </body>
</html>

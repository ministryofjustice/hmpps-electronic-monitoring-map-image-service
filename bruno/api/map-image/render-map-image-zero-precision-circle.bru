meta {
  name: Render map image (zero precision circle)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/map-image
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "output": { "width": 1000, "height": 700, "format": "png", "attribution": "Contains OS data © Crown copyright" },
    "viewport": { "mode": "fit", "fitToLayerIds": ["zero-radius", "device-positions"], "padding": 40 },
    "layers": [
      {
        "type": "circles",
        "id": "zero-radius",
        "points": [{ "latitude": 51.51, "longitude": -0.1, "precision": 0 }],
        "style": { "fill": "#ff000040", "stroke": { "color": "#ff0000", "width": 2 } }
      },
      {
        "type": "locations",
        "id": "device-positions",
        "points": [
          { "latitude": 51.505, "longitude": -0.11 },
          { "latitude": 51.515, "longitude": -0.095 }
        ],
        "marker": { "type": "circle", "radius": 5, "fill": "#1d70b8", "stroke": { "color": "#1d70b8", "width": 0.5 } }
      }
    ]
  }
}

tests {
  test("it should respond with an OK status", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("it should respond with a png image", function () {
    expect(res.getHeader("content-type")).to.equal("image/png");
  });
}

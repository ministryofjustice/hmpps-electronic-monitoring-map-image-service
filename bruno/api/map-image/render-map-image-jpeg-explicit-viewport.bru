meta {
  name: Render map image (jpeg, explicit viewport)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/map-image
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "output": { "width": 800, "height": 600, "format": "jpeg", "quality": 85, "pixelRatio": 1.5 },
    "viewport": { "mode": "explicit", "centre": { "latitude": 51.51, "longitude": -0.1 }, "zoom": 14 },
    "controls": { "compass": false, "scaleBar": "line" },
    "layers": [
      {
        "type": "tracks",
        "id": "route",
        "points": [
          { "latitude": 51.5, "longitude": -0.12 },
          { "latitude": 51.51, "longitude": -0.1 },
          { "latitude": 51.52, "longitude": -0.09 }
        ],
        "style": { "stroke": { "color": "#d4351c", "lineDash": [10, 10] } }
      },
      {
        "type": "locations",
        "id": "stops",
        "points": [
          { "latitude": 51.5, "longitude": -0.12 },
          { "latitude": 51.52, "longitude": -0.09 }
        ],
        "marker": { "radius": 7, "fill": "#00703c" }
      },
      {
        "type": "text",
        "id": "stop-labels",
        "points": [
          { "latitude": 51.5, "longitude": -0.12, "label": "Start" },
          { "latitude": 51.52, "longitude": -0.09, "label": "End" }
        ],
        "style": { "haloColor": "#ffffff", "haloWidth": 3, "offset": { "y": 18 } }
      }
    ]
  }
}

tests {
  test("it should respond with an OK status", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("it should respond with a jpeg image", function () {
    expect(res.getHeader("content-type")).to.equal("image/jpeg");
  });
}
